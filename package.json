{
  "name": "campus-resolve-monorepo",
  "version": "1.0.0",
  "description": "College Complaint & Grievance Management System (CampusResolve)",
  "private": true,
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "build": "cd client && npm install && npm run build && node -e \"const fs=require('fs'); if(fs.existsSync('./.next')) { fs.cpSync('./.next', '../.next', {recursive: true}); }\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.8",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  },
  "keywords": [
    "college-management",
    "grievance-management",
    "complaint-management",
    "campus",
    "student-portal",
    "admin-dashboard",
    "ai-triage"
  ],
  "author": "CampusResolve Team",
  "license": "MIT"
}
