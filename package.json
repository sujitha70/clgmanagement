{
  "name": "campus-resolve-monorepo",
  "version": "1.0.0",
  "description": "College Complaint & Grievance Management System (CampusResolve)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "college-management",
    "grievance-management",
    "complaint-management",
    "campus",
    "student-portal",
    "admin-dashboard",
    "ai-triage"
  ],
  "author": "CampusResolve Team",
  "license": "MIT"
}
